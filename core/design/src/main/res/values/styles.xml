<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== Theme ==================== -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.Camera">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <!-- ==================== Typography ==================== -->
    <!--
      One family (the platform sans), two weights and one monospace for numbers. Hierarchy
      is carried by size, colour and letter spacing instead of extra fonts, which keeps the
      APK small and the rendering crisp at 240 dpi.
    -->
    <style name="Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- The single large reading on a screen. Reserved for "the answer". -->
    <style name="Text.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- A smaller reading, used when two numbers share one card. -->
    <style name="Text.Readout">
        <item name="android:textSize">@dimen/text_mono</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Subtitle">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Text.Label">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- Section label above a group of rows: quiet, small, widely tracked. -->
    <style name="Text.Section">
        <item name="android:textSize">@dimen/text_eyebrow</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <!-- Tiny label inside a card ("EXPRESSION", "RESULT"). -->
    <style name="Text.Eyebrow">
        <item name="android:textSize">@dimen/text_eyebrow</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.16</item>
    </style>

    <style name="Text.Mono">
        <item name="android:textSize">@dimen/text_mono</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ==================== Base widget style ==================== -->
    <!-- Base styles so that the dotted child styles have a valid implicit parent. -->
    <style name="Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.App">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- ==================== Buttons ==================== -->
    <style name="Widget.App.Button" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingLeft">@dimen/space_lg</item>
        <item name="android:paddingRight">@dimen/space_lg</item>
    </style>

    <style name="Widget.App.Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.App.Button.Ghost">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Widget.App.Button.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <!-- Keys of the on-screen keypad. -->
    <style name="Widget.App.Button.Key">
        <item name="android:layout_height">@dimen/key_height</item>
        <item name="android:minHeight">@dimen/key_height</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_mono</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.App.Button.Key.Operator">
        <item name="android:background">@drawable/bg_key_operator</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Widget.App.Button.Key.Accent">
        <item name="android:background">@drawable/bg_key_accent</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
    </style>

    <!-- Small pill used for function chips above a keypad. -->
    <style name="Widget.App.Chip">
        <item name="android:layout_height">32dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingLeft">@dimen/space_md</item>
        <item name="android:paddingRight">@dimen/space_md</item>
    </style>

    <!-- ==================== Containers ==================== -->
    <style name="Widget.App.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_md</item>
    </style>

    <style name="Widget.App.Tile">
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/space_sm</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="Widget.App.ListItem">
        <item name="android:background">@drawable/bg_list_item</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">@dimen/space_md</item>
        <item name="android:paddingRight">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="Widget.App.Field">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:paddingLeft">@dimen/space_md</item>
        <item name="android:paddingRight">@dimen/space_md</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.App.Spinner" parent="@android:style/Widget.Material.Spinner.Underlined">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:popupBackground">@color/surface_high</item>
    </style>

    <style name="Widget.App.Switch" parent="@android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:thumbTint">@color/primary</item>
        <item name="android:trackTint">@color/outline_strong</item>
    </style>

    <style name="Widget.App.Progress" parent="@android:style/Widget.Material.ProgressBar.Horizontal">
        <item name="android:progressTint">@color/primary</item>
        <item name="android:progressBackgroundTint">@color/surface_high</item>
    </style>

    <style name="Widget.App.Separator">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
    </style>
</resources>
