<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== Theme ==================== -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="AppTheme.Camera">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <!-- ==================== Typography ==================== -->
    <style name="Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Subtitle">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Text.Label">
        <item name="android:textSize">@dimen/text_label</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Text.Section">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Text.Mono">
        <item name="android:textSize">@dimen/text_mono</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ==================== Base widget style ==================== -->
    <!-- Base styles so that the dotted child styles have a valid implicit parent. -->
    <style name="Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.App">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- ==================== Buttons ==================== -->
    <style name="Widget.App.Button" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingLeft">@dimen/space_md</item>
        <item name="android:paddingRight">@dimen/space_md</item>
    </style>

    <style name="Widget.App.Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.App.Button.Ghost">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.App.Button.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.App.Button.Key">
        <item name="android:layout_height">@dimen/key_height</item>
        <item name="android:minHeight">@dimen/key_height</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- ==================== Containers ==================== -->
    <style name="Widget.App.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_md</item>
    </style>

    <style name="Widget.App.Tile">
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/space_xs</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <style name="Widget.App.ListItem">
        <item name="android:background">@drawable/bg_list_item</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">@dimen/space_md</item>
        <item name="android:paddingRight">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <style name="Widget.App.Field">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:paddingLeft">@dimen/space_sm</item>
        <item name="android:paddingRight">@dimen/space_sm</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.App.Spinner" parent="@android:style/Widget.Material.Spinner.Underlined">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:popupBackground">@color/surface_high</item>
    </style>

    <style name="Widget.App.Switch" parent="@android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:thumbTint">@color/primary</item>
        <item name="android:trackTint">@color/outline_strong</item>
    </style>

    <style name="Widget.App.Progress" parent="@android:style/Widget.Material.ProgressBar.Horizontal">
        <item name="android:progressTint">@color/primary</item>
        <item name="android:progressBackgroundTint">@color/surface_high</item>
    </style>

    <style name="Widget.App.Separator">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/outline</item>
    </style>
</resources>
