    <string name="about_keys_numbers">The numeric keypad types directly into the value field.</string>
    <string name="about_keys_back">Back returns to the previous screen.</string>
    <string name="about_keys_star">Star toggles the sign of the value.</string>
    <string name="about_keys_hash">Hash clears the value.</string>
